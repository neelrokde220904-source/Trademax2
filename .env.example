# ===========================================
# India AI Trader — Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values.

# --- Angel One SmartAPI ---
ANGEL_API_KEY=your_api_key_here
ANGEL_CLIENT_ID=your_client_id
ANGEL_MPIN=your_mpin
ANGEL_TOTP_SECRET=your_totp_secret_key

# --- Anthropic ---
ANTHROPIC_API_KEY=your_anthropic_key

# --- Universal LLM factory ---
# Set a provider explicitly, or use "auto" to select the first configured API key.
# Separate providers/models can be selected for research and decision tiers.
# Providers: openai, google, anthropic, xai, deepseek, dashscope, zhipu,
# minimax, mistral, moonshot, groq, nvidia, openrouter, azure_openai,
# aws_bedrock, ollama, openai_compatible.
TRADEMAX_LLM_PROVIDER=auto
TRADEMAX_QUICK_THINK_PROVIDER=
TRADEMAX_QUICK_THINK_LLM=
TRADEMAX_DEEP_THINK_PROVIDER=
TRADEMAX_DEEP_THINK_LLM=
TRADEMAX_TEMPERATURE=0
TRADEMAX_LLM_RETRY_BUDGET=0
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
MISTRAL_API_KEY=
MOONSHOT_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AWS_DEFAULT_REGION=
OLLAMA_BASE_URL=http://localhost:11434/v1
OPENAI_COMPATIBLE_API_KEY=
TRADEMAX_LLM_BACKEND_URL=

# --- Dashboard model profiles ---
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_DECISION_MODEL=claude-opus-4-6
DEEPSEEK_API_KEY=your_deepseek_key
ECONOMY_FAST_MODEL=deepseek-flash
ECONOMY_DECISION_MODEL=deepseek-v4-pro
ECONOMY_DECISION_MAX_TOKENS=8192
LLM_TIMEOUT_SECONDS=60
# Display conversion only, not a live FX quote or a spending cap.
LLM_USD_INR_RATE=90

# --- News ---
NEWS_API_KEY=your_newsapi_key

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# --- Zerodha Kite Connect ---
# Use the official OAuth login to obtain a daily access token. TOTP alone does
# not authorize Kite Connect API sessions.
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
TRADEMAX_BROKER_MODE=angel_only
TRADEMAX_PRIMARY_BROKER=angel
TRADEMAX_STATIC_OUTBOUND_IP=
# Set true only after confirming the IP in every active broker's account console.
BROKER_STATIC_IP_ALLOWLIST_CONFIRMED=false

# --- Trading Config ---
PAPER_TRADING=true
# Required only if PAPER_TRADING=false. Keep this unset for paper trading.
LIVE_TRADING_ACKNOWLEDGEMENT=
INITIAL_CAPITAL=100000
MAX_CAPITAL_PER_TRADE_PCT=0.10
RISK_PER_TRADE_PCT=0.005
MAX_TOTAL_EXPOSURE_PCT=0.50
MAX_DAILY_ENTRIES=3
# The normal paper order path enforces these in addition to the overall cap.
MAX_DAILY_ENTRIES_PER_SYMBOL=1
SYMBOL_REENTRY_COOLDOWN_MINUTES=30
MIN_NET_REWARD_RISK=2.0
MAX_COST_TO_GROSS_REWARD_PCT=0.25
MAX_POSITIONS=8
MAX_DAILY_LOSS_PCT=0.02
MAX_PORTFOLIO_DRAWDOWN_PCT=0.10
TRADING_UNIVERSE_MODE=nifty50
# Entry stop/target distances in daily ATR(14) units
TECHNICAL_STOP_DAILY_ATR_MULTIPLIER=1.0
TECHNICAL_TARGET_DAILY_ATR_MULTIPLIER=2.5
# Protective exits remain LIMIT orders inside a fresh-price adverse collar.
# An unfilled exit remains monitored; this is not a guaranteed stop fill.
PROTECTIVE_EXIT_COLLAR_PCT=0.003
# An unfilled protective exit widens its collar by one step of the value above per
# attempt, up to this many multiples (3 x 0.3% = 0.9% maximum); it never uses MARKET.
PROTECTIVE_EXIT_MAX_REPRICE_STEPS=3
# Entries are blocked once a scan has run longer than this (exits are never affected).
SCAN_ENTRY_DEADLINE_SECONDS=900
# Paid scans are skipped for the rest of the IST day once estimated LLM spend reaches this.
LLM_DAILY_BUDGET_INR=50
# Model partial paper entries from top-of-book depth when depth is known (off by default).
PAPER_PARTIAL_FILL_ENABLED=false
# Order submission limiter across entries and exits; exits are never dropped.
ORDER_RATE_PER_SECOND=5
ORDER_RATE_PER_MINUTE=100
# Optional extra NSE holiday dates (comma-separated ISO) merged with
# data/calendars/nse_equity_holidays.json. It cannot remove a holiday.
NSE_HOLIDAYS=
# Pre-LLM screener: minimum full-session liquidity, fresh top-of-book spread,
# session volume vs prior sessions, and minimum 15-minute ATR/price
SCREENER_MIN_RELATIVE_VOLUME=1.0
SCREENER_MIN_AVERAGE_DAILY_TURNOVER_INR=100000000
SCREENER_MIN_LIQUIDITY_SESSIONS=10
SCREENER_MAX_SPREAD_PCT=0.003
SCREENER_MAX_QUOTE_AGE_SECONDS=30
MAX_ORDER_PARTICIPATION_PCT=0.01
# Refuse a broker instrument cache older than seven days (maximum 168 hours).
INSTRUMENT_CACHE_MAX_AGE_HOURS=168
SCREENER_BREAKOUT_MIN_RELATIVE_VOLUME=1.5
SCREENER_MIN_ATR_PCT=0.002
SCREENER_VWAP_CHOP_BARS=8
SCREENER_VWAP_CHOP_BAND_PCT=0.005
SCREENER_BREAKOUT_LOOKBACK_BARS=20

# --- System ---
DATABASE_URL=sqlite:///./india_trader.db
LOG_LEVEL=INFO
DASHBOARD_PORT=8000

# Comma-separated values are supported.
GLOBAL_WATCHLIST=SPY,QQQ,AAPL,MSFT,GOOGL,AMZN,TSLA
# Calendar days after which a SWING / POSITIONAL position is exited by time.
SWING_MAX_HOLDING_DAYS=10
POSITIONAL_MAX_HOLDING_DAYS=60
# Paper model: BTST shares count as delivered this many minutes after the next session opens.
BTST_DELIVERY_MINUTES_AFTER_OPEN=15
# Strategy sleeves: every one ships disabled and needs its own explicit opt-in after T10 evidence.
STRATEGY_ORB_INTRADAY_ENABLED=false
STRATEGY_SUPERTREND_ADX_ENABLED=false
STRATEGY_MEAN_REVERSION_ENABLED=false
STRATEGY_MOMENTUM_BREAKOUT_ENABLED=false
STRATEGY_VCP_NR7_SWING_ENABLED=false
STRATEGY_BTST_STRENGTH_ENABLED=false
STRATEGY_ETF_ROTATION_ENABLED=false
# ETFs ranked by the rotation sleeve (they must also be in the watchlist so data is loaded).
ETF_ROTATION_UNIVERSE=NIFTYBEES,BANKBEES,GOLDBEES
# Consult the calibrated signal gate (and half-Kelly reducer) for entries. Needs a trained artefact
# with enough settled outcomes; with no model every entry is blocked, so leave it false until then.
SIGNAL_GATE_ENABLED=false
# US equities through the Alpaca PAPER endpoint only (needs ALPACA_PAPER=true and paper keys; live is unsupported).
FOREIGN_US_PAPER_ENABLED=false
ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Reuses GLOBAL_WATCHLIST. Static FX is used only to enforce the INR portfolio exposure caps.
FOREIGN_USD_INR_RATE=90
# Local crypto spot simulator: no exchange, no real orders, off by default.
CRYPTO_SIM_ENABLED=false
# Starting simulated balance and supported spot pairs; only public Binance prices may trigger trades.
CRYPTO_SIM_STARTING_USDT=500
CRYPTO_SIM_WATCHLIST=BTCUSDT,ETHUSDT,SOLUSDT
# Static USDT->INR rate used only for reporting; it is labelled as configured, not a market quote.
CRYPTO_USDT_INR_RATE=88
# Daily loss at which the crypto simulator stops entering (independent of the India halt).
CRYPTO_HALT_DAILY_LOSS_PCT=0.05
